{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./cad:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./models/**/out/*.stl)",
      "Read(./models/**/out/*.3mf)",
      "Read(./models/**/out/*.step)",
      "Read(./models/**/out/report.json)",
      "Read(./models/**/out/.work/**)",
      "Read(./.venv/**)",
      "Read(./uv.lock)"
    ]
  }
}
